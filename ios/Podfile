# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native-permissions/scripts/setup.rb", {paths: [process.argv[1]]})',
  __dir__]).strip

platform :ios, min_ios_version_supported

prepare_react_native_project!
setup_permissions(['LocationWhenInUse', 'Notifications'])

linkage = ENV['USE_FRAMEWORKS']

if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green

  use_frameworks! :linkage => linkage.to_sym
end

target 'RoadRadar' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    $MLRN.post_install(installer)

    # react-native-config's generated native module is built as a separate Pod
    # target, so the app target's ENVFILE setting does not reliably reach it.
    # Pin the same env selection on that Pod target for every build variant.
    react_native_config = installer.pods_project.targets.find do |pod_target|
      pod_target.name == 'react-native-config'
    end
    if react_native_config
      react_native_config.build_configurations.each do |build_configuration|
        build_configuration.build_settings['ENVFILE'] =
          build_configuration.name == 'Release' ? '.env.production' : '.env'
      end
    end
  end
end
