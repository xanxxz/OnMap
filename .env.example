# Production map: MapTiler Streets is primary when this key is configured.
# Keep the key outside source control. If empty, OpenFreeMap Liberty is used.
MAPTILER_API_KEY=

# Shared override for both platforms.
# Use the computer LAN IP or an external dev URL on physical devices.
# Use HTTPS URLs in production. These values override platform defaults below.
API_BASE_URL=
SOCKET_URL=

# iOS Simulator can reach the host through localhost.
IOS_API_BASE_URL=http://localhost:4000/api
IOS_SOCKET_URL=http://localhost:4000

# Android Emulator reaches the host through 10.0.2.2.
ANDROID_API_BASE_URL=http://10.0.2.2:4000/api
ANDROID_SOCKET_URL=http://10.0.2.2:4000

REALTIME_ENABLED=true
