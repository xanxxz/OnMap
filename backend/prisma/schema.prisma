generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoadEventType {
  ACCIDENT
  ROAD_CLOSURE
  ROADWORKS
  TRAFFIC
  ROAD_HAZARD
  TRAFFIC_LIGHT
  ROAD_SERVICE
  ROAD_PATROL
  OTHER
}

enum RoadEventStatus {
  ACTIVE
  UNCONFIRMED
  STALE
  HIDDEN_PENDING_REVIEW
  RESOLVED
}

enum RoadEventSource {
  USER
  TELEGRAM
}

enum RoadEventLocationPrecision {
  EXACT
  INTERSECTION
  LANDMARK
  STREET
  AREA
  SETTLEMENT
}

enum RoadEventFeedbackAction {
  CONFIRM
  REJECT
}

enum PartnerPlacementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum PartnerContactType {
  PHONE
  EMAIL
  WEBSITE
  TELEGRAM
  OTHER
}

enum PartnerStatAction {
  POINT_OPEN
  CONTACT_CLICK
  BANNER_IMPRESSION
  BANNER_CLICK
}

enum PushPlatform {
  IOS
  ANDROID
}

enum PushProviderKind {
  APNS
  FCM
}

enum PushOutboxKind {
  ROAD_EVENT
  PARTNER_POINT
  GENERAL
}

enum PushOutboxStatus {
  PENDING
  SENDING
  RETRY
  SENT
  CANCELLED
}

enum PartnerPushCampaignStatus {
  AWAITING_CONFIRMATION
  QUEUED
  CANCELLED
}

enum PushCampaignKind {
  GENERAL
  PARTNER_POINT
}

enum PushScheduleKind {
  NOW
  ONCE
  DAILY
  WEEKLY
}

enum PushCampaignStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum PushCampaignRunStatus {
  QUEUED
  SKIPPED
}

// Tokens are server-only delivery credentials. Neither token nor identity key is public.
model PushDevice {
  id String @id @default(uuid()) @db.Uuid
  identityKey String @map("identity_key") @db.Char(64)
  installationId String @map("installation_id") @db.Uuid
  cityId String @map("city_id") @db.VarChar(64)
  platform PushPlatform
  provider PushProviderKind
  token String @db.VarChar(512)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  enabled Boolean @default(true)
  roadPushEnabled Boolean @default(true) @map("road_push_enabled")
  newsPushEnabled Boolean @default(true) @map("news_push_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries PushOutbox[]

  @@unique([identityKey, installationId], map: "push_device_identity_installation_key")
  @@index([cityId, enabled], map: "push_device_city_enabled_idx")
  @@map("push_devices")
}

model PushOutbox {
  id String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  dedupeKey String @map("dedupe_key") @db.VarChar(120)
  kind PushOutboxKind
  targetId String @map("target_id") @db.Uuid
  cityId String @map("city_id") @db.VarChar(64)
  campaignRunId String? @map("campaign_run_id") @db.Uuid
  status PushOutboxStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  lastErrorCode String? @map("last_error_code") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  campaignRun PushCampaignRun? @relation(fields: [campaignRunId], references: [id], onDelete: SetNull)

  @@unique([deviceId, dedupeKey], map: "push_outbox_device_dedupe_key")
  @@index([status, nextAttemptAt], map: "push_outbox_due_idx")
  @@map("push_outbox")
}

model PushCampaign {
  id String @id @default(uuid()) @db.Uuid
  ownerTelegramId String @map("owner_telegram_id") @db.VarChar(64)
  kind PushCampaignKind
  partnerPointId String? @map("partner_point_id") @db.Uuid
  cityIds Json @map("city_ids")
  title String @db.VarChar(100)
  body String @db.VarChar(240)
  scheduleKind PushScheduleKind @map("schedule_kind")
  localTime String? @map("local_time") @db.VarChar(5)
  weekday Int?
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  nextRunAt DateTime? @map("next_run_at") @db.Timestamptz(3)
  status PushCampaignStatus @default(ACTIVE)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  runs PushCampaignRun[]
  citySchedules PushCampaignCitySchedule[]

  @@index([status, nextRunAt], map: "push_campaign_due_idx")
  @@index([ownerTelegramId, createdAt], map: "push_campaign_owner_idx")
  @@map("push_campaigns")
}

model PushCampaignCitySchedule {
  campaignId String @map("campaign_id") @db.Uuid
  cityId String @map("city_id") @db.VarChar(64)
  timeZone String @map("time_zone") @db.VarChar(64)
  nextRunAt DateTime? @map("next_run_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  campaign PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, cityId])
  @@index([nextRunAt], map: "push_campaign_city_due_idx")
  @@map("push_campaign_city_schedules")
}

model PushCampaignRun {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  cityId String @default("") @map("city_id") @db.VarChar(64)
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(3)
  status PushCampaignRunStatus
  audienceCount Int @default(0) @map("audience_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  campaign PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliveries PushOutbox[]

  @@unique([campaignId, cityId, scheduledAt], map: "push_campaign_run_city_schedule_key")
  @@map("push_campaign_runs")
}

model PushBotDraft {
  ownerTelegramId String @id @map("owner_telegram_id") @db.VarChar(64)
  step String @db.VarChar(32)
  payload Json
  revision Int @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("push_bot_drafts")
}

// Owner-only Telegram control-panel state. Opaque callbacks never contain
// entity identifiers or user-entered text.
model TelegramBotPanelSession {
  ownerTelegramId String @id @map("owner_telegram_id") @db.VarChar(64)
  screen String @db.VarChar(48)
  revision Int @default(0)
  payload Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("telegram_bot_panel_sessions")
}

model TelegramBotPanelAction {
  token String @id @db.VarChar(24)
  ownerTelegramId String @map("owner_telegram_id") @db.VarChar(64)
  revision Int
  action String @db.VarChar(48)
  payload Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerTelegramId, revision], map: "telegram_bot_panel_actions_owner_revision_idx")
  @@index([expiresAt], map: "telegram_bot_panel_actions_expiry_idx")
  @@map("telegram_bot_panel_actions")
}

model PushOwnerPairing {
  id String @id @default(uuid()) @db.Uuid
  ownerTelegramId String @map("owner_telegram_id") @db.VarChar(64)
  codeHash String @unique @map("code_hash") @db.VarChar(64)
  deviceId String? @map("device_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  testSentAt DateTime? @map("test_sent_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerTelegramId, consumedAt], map: "push_owner_pairings_owner_idx")
  @@index([expiresAt], map: "push_owner_pairings_expiry_idx")
  @@map("push_owner_pairings")
}

model PushOwnerPairingAttempt {
  identityKey String @id @map("identity_key") @db.VarChar(64)
  count Int @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  @@map("push_owner_pairing_attempts")
}

model PartnerPushCampaign {
  id String @id @default(uuid()) @db.Uuid
  partnerPointId String @map("partner_point_id") @db.Uuid
  status PartnerPushCampaignStatus @default(AWAITING_CONFIRMATION)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)

  @@index([partnerPointId, approvedAt], map: "partner_push_campaign_point_idx")
  @@map("partner_push_campaigns")
}

// Daily counters contain no actor, coordinates, contact values, or identity tokens.
model PartnerStatDaily {
  id String @id @default(uuid()) @db.Uuid
  partnerPointId String @map("partner_point_id") @db.Uuid
  action PartnerStatAction
  detailId String @default("") @map("detail_id") @db.VarChar(36)
  day DateTime @db.Date
  count Int @default(0)

  @@unique([partnerPointId, action, detailId, day], map: "partner_stat_daily_unique")
  @@index([partnerPointId, day], map: "partner_stat_daily_point_day_idx")
  @@index([day, action], map: "partner_stat_daily_day_action_idx")
  @@map("partner_stat_daily")
}

// Short-lived, keyed pseudonyms only prevent repeated actions in a time window.
model PartnerStatWindow {
  id String @id @default(uuid()) @db.Uuid
  partnerPointId String @map("partner_point_id") @db.Uuid
  action PartnerStatAction
  detailId String @default("") @map("detail_id") @db.VarChar(36)
  actorHash String @map("actor_hash") @db.VarChar(64)
  lastAcceptedAt DateTime @map("last_accepted_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([partnerPointId, action, detailId, actorHash], map: "partner_stat_window_unique")
  @@index([expiresAt], map: "partner_stat_window_expiry_idx")
  @@map("partner_stat_windows")
}

model PartnerPoint {
  id String @id @default(uuid()) @db.Uuid

  cityId String @map("city_id") @db.VarChar(64)

  title String @db.VarChar(160)

  category String @db.VarChar(64)

  backgroundColor String @default("#153D32") @map("background_color") @db.VarChar(7)

  textColor String @default("#FDFBF4") @map("text_color") @db.VarChar(7)

  description String? @db.VarChar(1000)

  longitude Float?

  latitude Float?

  displayAddress String? @map("display_address") @db.VarChar(240)

  // An opaque identifier for a future managed media store, never a filesystem path or URL.
  imageAssetKey String? @map("image_asset_key") @db.VarChar(240)

  promoCode String? @map("promo_code") @db.VarChar(32)

  promoTerms String? @map("promo_terms") @db.VarChar(240)

  agreedPriceKopecks BigInt? @map("agreed_price_kopecks")

  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  endsAt DateTime @map("ends_at") @db.Timestamptz(3)

  status PartnerPlacementStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contacts PartnerPointContact[]

  banners PartnerCityBanner[]

  @@index([cityId, status, startsAt, endsAt], map: "partner_points_visibility_idx")
  @@index([cityId, longitude, latitude], map: "partner_points_viewport_idx")
  @@map("partner_points")
}

// First observed after tracking was deployed; never stores tokens or raw identities.
model AnonymousIdentitySeen {
  identityHash String @id @map("identity_hash") @db.Char(64)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  @@map("anonymous_identities_seen")
}

model AnonymousIdentityCount {
  id Int @id
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  count BigInt @default(0)

  @@map("anonymous_identity_count")
}

// Small normalized PNG marker assets live in PostgreSQL, not in the read-only container.
model PartnerImageAsset {
  key String @id @db.Uuid
  pngBytes Bytes @map("png_bytes") @db.ByteA
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("partner_image_assets")
}

model PartnerPointContact {
  id String @id @default(uuid()) @db.Uuid

  partnerPointId String @map("partner_point_id") @db.Uuid

  type PartnerContactType

  label String @db.VarChar(80)

  value String @db.VarChar(500)

  displayOrder Int @default(0) @map("display_order")

  partnerPoint PartnerPoint @relation(fields: [partnerPointId], references: [id], onDelete: Cascade)

  @@index([partnerPointId, displayOrder, id], map: "partner_point_contacts_order_idx")
  @@map("partner_point_contacts")
}

model PartnerCityBanner {
  id String @id @default(uuid()) @db.Uuid

  cityId String @unique @map("city_id") @db.VarChar(64)

  title String? @db.VarChar(160)

  partnerPointId String? @map("partner_point_id") @db.Uuid

  partnerPoint PartnerPoint? @relation(fields: [partnerPointId], references: [id], onDelete: SetNull)

  text String? @db.VarChar(300)

  buttonLabel String? @map("button_label") @db.VarChar(80)

  buttonUrl String? @map("button_url") @db.VarChar(2048)

  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)

  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)

  enabled Boolean @default(false)

  agreedPriceKopecks BigInt? @map("agreed_price_kopecks")

  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cityId, enabled, startsAt, endsAt], map: "partner_city_banners_visibility_idx")
  @@index([partnerPointId], map: "partner_city_banners_partner_point_id_idx")
  @@map("partner_city_banners")
}

model PartnerBotDraft {
  ownerTelegramId String @id @map("owner_telegram_id") @db.VarChar(64)

  kind String @db.VarChar(16)

  step String @db.VarChar(32)

  payload Json

  revision Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("partner_bot_drafts")
}

model RoadEvent {
  id String @id @default(uuid()) @db.Uuid

  cityId String @map("city_id") @db.VarChar(64)

  type RoadEventType

  status RoadEventStatus @default(UNCONFIRMED)

  source RoadEventSource @default(USER)

  title String @db.VarChar(160)

  description String? @db.VarChar(500)

  longitude Float

  latitude Float

  location Unsupported("geometry(Geometry, 4326)")

  locationPrecision RoadEventLocationPrecision? @map("location_precision")

  locationLabel String? @map("location_label") @db.VarChar(200)

  sourceText String? @map("source_text") @db.VarChar(1000)

  createdByInstallationId String? @map("created_by_installation_id") @db.VarChar(128)

  confirmationCount Int @default(0) @map("confirmation_count")

  rejectionCount Int @default(0) @map("rejection_count")

  lastConfirmedAt DateTime? @map("last_confirmed_at") @db.Timestamptz(3)

  confidence Float @default(0.5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  statusBeforeModeration RoadEventStatus? @map("status_before_moderation")

  hiddenAt DateTime? @map("hidden_at") @db.Timestamptz(3)

  feedbacks RoadEventFeedback[]

  reports RoadEventReport[]

  telegramMessages TelegramRoadEventMessage[]

  @@index([cityId, status, expiresAt], map: "road_events_city_status_expires_idx")
  @@index([cityId, type, status], map: "road_events_city_type_status_idx")
  @@index([createdAt], map: "road_events_created_at_idx")
  @@index([location], type: Gist, map: "road_events_location_gist_idx")
  @@index([source, cityId, type, status, createdAt], map: "road_events_source_match_idx")
  @@map("road_events")
}

model TelegramRoadEventMessage {
  id String @id @default(uuid()) @db.Uuid

  source RoadEventSource @default(TELEGRAM)

  sourceChatId String @map("source_chat_id") @db.VarChar(64)

  externalMessageId String @map("external_message_id") @db.VarChar(160)

  roadEventId String? @map("road_event_id") @db.Uuid

  canonicalLocationId String? @map("canonical_location_id") @db.VarChar(128)

  sourceTimestamp DateTime @map("source_timestamp") @db.Timestamptz(3)

  appliedDecision String @map("applied_decision") @db.VarChar(16)

  outcome String @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roadEvent RoadEvent? @relation(fields: [roadEventId], references: [id], onDelete: SetNull)

  @@unique([source, sourceChatId, externalMessageId], map: "telegram_road_event_messages_source_identity_key")
  @@index([roadEventId], map: "telegram_road_event_messages_event_idx")
  @@index([canonicalLocationId, sourceTimestamp], map: "telegram_road_event_messages_location_time_idx")
  @@map("telegram_road_event_messages")
}

model TelegramSourceCursor {
  cityId String @map("city_id") @db.VarChar(64)

  sourceChatId String @map("source_chat_id") @db.VarChar(64)

  lastMessageId BigInt @map("last_message_id")

  lastMessageTimestamp DateTime? @map("last_message_timestamp") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([cityId, sourceChatId])
  @@map("telegram_source_cursors")
}

model RoadEventFeedback {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @map("road_event_id") @db.Uuid

  installationId String @map("installation_id") @db.VarChar(128)

  action RoadEventFeedbackAction

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roadEvent RoadEvent @relation(fields: [roadEventId], references: [id], onDelete: Cascade)

  @@unique([roadEventId, installationId], map: "road_event_feedback_event_installation_key")
  @@index([installationId], map: "road_event_feedback_installation_idx")
  @@index([createdAt], map: "road_event_feedback_created_at_idx")
  @@map("road_event_feedback")
}

model RoadEventReport {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @map("road_event_id") @db.Uuid

  reporterActorId String @map("reporter_actor_id") @db.VarChar(128)

  reason String @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roadEvent RoadEvent @relation(fields: [roadEventId], references: [id], onDelete: Cascade)

  @@unique([roadEventId, reporterActorId], map: "road_event_reports_event_actor_key")
  @@index([reporterActorId, createdAt], map: "road_event_reports_actor_created_idx")
  @@map("road_event_reports")
}

model RoadEventModerationCase {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @unique @map("road_event_id") @db.Uuid

  state String @default("PENDING_REVIEW") @db.VarChar(32)

  decisionAt DateTime? @map("decision_at") @db.Timestamptz(3)

  moderatorTelegramId String? @map("moderator_telegram_id") @db.VarChar(64)

  restrictionHours Int? @map("restriction_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("road_event_moderation_cases")
}

model ActorRestriction {
  actorId String @id @map("actor_id") @db.VarChar(128)

  blockedUntil DateTime @map("blocked_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdByModeratorId String @map("created_by_moderator_id") @db.VarChar(64)

  reason String @default("REPORT_REVIEW") @db.VarChar(32)

  @@index([blockedUntil], map: "actor_restrictions_blocked_until_idx")
  @@map("actor_restrictions")
}

model RoadEventAuthorNotice {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @map("road_event_id") @db.Uuid

  actorId String @map("actor_id") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  @@unique([roadEventId, actorId], map: "road_event_author_notices_event_actor_key")
  @@index([actorId, acknowledgedAt, createdAt], map: "road_event_author_notices_actor_idx")
  @@map("road_event_author_notices")
}

model TelegramModerationOutbox {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @map("road_event_id") @db.Uuid

  status String @default("PENDING") @db.VarChar(16)

  attempts Int @default(0)

  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)

  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)

  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)

  telegramMessageId String? @map("telegram_message_id") @db.VarChar(64)

  lastErrorCode String? @map("last_error_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roadEventId], map: "telegram_moderation_outbox_event_key")
  @@index([status, nextAttemptAt], map: "telegram_moderation_outbox_pending_idx")
  @@map("telegram_moderation_outbox")
}

model TelegramModerationUpdate {
  updateId BigInt @id @map("update_id")

  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("telegram_moderation_updates")
}

model RoadEventModerationAudit {
  id String @id @default(uuid()) @db.Uuid

  roadEventId String @map("road_event_id") @db.Uuid

  moderatorTelegramId String @map("moderator_telegram_id") @db.VarChar(64)

  decision String @db.VarChar(32)

  restrictionHours Int? @map("restriction_hours")

  telegramUpdateId BigInt? @unique @map("telegram_update_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([roadEventId, createdAt], map: "road_event_moderation_audit_event_idx")
  @@map("road_event_moderation_audit")
}

// Local owner console: capabilities are random, short lived and stored only as hashes.
model OwnerAdminSession {
  ownerTelegramId String @id @map("owner_telegram_id") @db.VarChar(64)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("owner_admin_sessions")
}

