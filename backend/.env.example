# Optional. Defaults to 4000 and must be a valid TCP port when set.
PORT=4000

# Required. PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://roadradar:roadradar_dev@localhost:5434/roadradar?schema=public

# Required. Use a private random value with at least 32 characters.
IDENTITY_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional. Used only by the manual TomTom traffic research probe.
TOMTOM_API_KEY=

# Optional. Server-only key for the compact current-weather card.
YANDEX_WEATHER_API_KEY=
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_CITY_IMPORT_CONCURRENCY=3
YANDEX_CITY_IMPORT_REQUEST_DELAY_MS=150

# Optional. Configure all values to enable Telegram MTProto user-session ingestion.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_SOURCE_CHAT_ID=

# Optional. Safe default is false; enable only after MTProto settings are verified.
TELEGRAM_INGESTION_ENABLED=false

# Optional development/runtime NDJSON diagnostics. Files are append-only and ignored by Git.
TELEGRAM_REVIEW_LOGS_ENABLED=false
TELEGRAM_REVIEW_LOG_DIR=runtime-logs/telegram

# Optional. OSM street geometry lookup for approximate Telegram STREET events.
OSM_STREET_GEOMETRY_ENABLED=false
# Optional ordered primary/fallback list; at most two endpoints are tried per lookup.
OSM_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OSM_STREET_GEOMETRY_CACHE_DIR=runtime-data/osm-streets
