# Backend/migrator environment. Copy to backend.env on the VPS and chmod 600.
# The backend gets DATABASE_URL, but not the separate POSTGRES_PASSWORD variable.
PORT=4000
DATABASE_URL=postgresql://onmap:replace-with-a-long-random-password@postgres:5432/onmap?schema=public
IDENTITY_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Comma-separated exact browser origins; empty is suitable for native-only clients.
CORS_ALLOWED_ORIGINS=

# Enable only after each integration is configured and separately smoke-tested.
TELEGRAM_MODERATION_BOT_TOKEN=
TELEGRAM_MODERATION_CHAT_ID=
TELEGRAM_PARTNER_OWNER_IDS=
TELEGRAM_MODERATION_RESTRICTION_HOURS=24,168,720
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_SOURCE_CHAT_ID=
TELEGRAM_INGESTION_ENABLED=false
TELEGRAM_REVIEW_LOGS_ENABLED=false
PUSH_ENQUEUE_ENABLED=false
PUSH_DELIVERY_ENABLED=false
PUSH_ROAD_EVENT_NOT_BEFORE=

# Optional integration values; leave unset unless the feature is needed.
TOMTOM_API_KEY=
OSM_STREET_GEOMETRY_ENABLED=false
